{
	"name": "@twin.org/schema",
	"version": "0.0.3-next.1",
	"description": "Schema",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-schema.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"scripts": {
		"format": "prettier --write .",
		"lint:format": "prettier --config prettier.config.mjs --check .",
		"lint:markdown": "markdownlint **/*.md --ignore **/node_modules/** --ignore **/docs/reference/**",
		"lint:spell": "cspell ** --no-progress",
		"lint": "npm run lint:format && npm run lint:markdown && npm run lint:spell",
		"docs": "node ./scripts/workspaces.mjs docs",
		"dist": "echo There is no dist in this package",
		"commitlint": "commitlint --edit",
		"prepare": "husky",
		"update-schemas": "node scripts/update-schemas.mjs && npm run format"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "20.5.0",
		"@commitlint/config-conventional": "20.5.0",
		"cspell": "9.7.0",
		"fast-glob": "3.3.3",
		"husky": "9.1.7",
		"markdownlint-cli": "0.48.0",
		"prettier": "3.8.1"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"schema"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-schema/issues"
	},
	"homepage": "https://twindev.org"
}
