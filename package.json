{
	"name": "@twin.org/schema",
	"version": "0.10.1",
	"description": "Schema",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-schema.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"scripts": {
		"format": "prettier --write . --log-level silent",
		"lint:format": "prettier --config prettier.config.mjs --check .",
		"lint:markdown": "markdownlint-cli2",
		"lint:spell": "cspell ** --no-progress",
		"lint": "concurrently -g -n format,markdown,spell \"pnpm run lint:format\" \"pnpm run lint:markdown\" \"pnpm run lint:spell\"",
		"docs": "node ./scripts/workspaces.mjs docs",
		"dist": "echo There is no dist in this package",
		"quality": "pnpm run format && pnpm run lint && pnpm run dist",
		"commitlint": "commitlint --edit",
		"prepare": "node ./scripts/install-hooks.mjs",
		"update-schemas": "node scripts/update-schemas.mjs && pnpm run format",
		"package:update": "pnpm update --interactive --latest"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"concurrently": "10.0.5",
		"cspell": "10.3.3",
		"fast-glob": "3.3.3",
		"markdownlint-cli2": "0.23.3",
		"prettier": "3.9.8"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"schema"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-schema/issues"
	},
	"homepage": "https://twindev.org"
}
