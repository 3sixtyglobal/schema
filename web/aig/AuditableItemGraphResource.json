{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/aig/AuditableItemGraphResource",
	"title": "AuditableItemGraphResource",
	"description": "Interface describing an auditable item graph vertex resource.",
	"type": "object",
	"properties": {
		"@context": {
			"anyOf": [
				{
					"const": "https://schema.3sixty.global/aig/"
				},
				{
					"type": "array",
					"prefixItems": [
						{
							"const": "https://schema.3sixty.global/aig/"
						}
					],
					"items": {
						"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionElement"
					},
					"minItems": 1
				}
			],
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "AuditableItemGraphResource",
			"description": "JSON-LD Type."
		},
		"resourceObject": {
			"$ref": "https://schema.3sixty.global/json-ld/JsonLdNodeObject",
			"description": "The JSON-LD object for the resource."
		}
	},
	"required": ["type"],
	"allOf": [
		{
			"$ref": "https://schema.3sixty.global/aig/AuditableItemGraphAuditedElement"
		}
	]
}
