{
	"@context": {
		"@version": 1.1,
		"twin-aig": "https://schema.3sixty.global/aig/",
		"sch": "http://schema.org/",
		"id": "@id",
		"type": "@type",
		"AuditableItemGraphAlias": "twin-aig:AuditableItemGraphAlias",
		"AuditableItemGraphAuditedElement": "twin-aig:AuditableItemGraphAuditedElement",
		"AuditableItemGraphPatchOperation": "twin-aig:AuditableItemGraphPatchOperation",
		"AuditableItemGraphChangeset": "twin-aig:AuditableItemGraphChangeset",
		"AuditableItemGraphChangesetList": "twin-aig:AuditableItemGraphChangesetList",
		"AuditableItemGraphEdge": "twin-aig:AuditableItemGraphEdge",
		"AuditableItemGraphResource": "twin-aig:AuditableItemGraphResource",
		"AuditableItemGraphListPatch": "twin-aig:AuditableItemGraphListPatch",
		"AuditableItemGraphVertex": "twin-aig:AuditableItemGraphVertex",
		"AuditableItemGraphPartialVertex": "twin-aig:AuditableItemGraphPartialVertex",
		"AuditableItemGraphVertexList": "twin-aig:AuditableItemGraphVertexList",
		"AuditableItemGraphVertexVersionList": "twin-aig:AuditableItemGraphVertexVersionList",
		"add": {
			"@id": "twin-aig:add",
			"@container": "@set"
		},
		"aliases": {
			"@id": "twin-aig:aliases",
			"@container": "@set"
		},
		"aliasFormat": {
			"@id": "twin-aig:aliasFormat",
			"@type": "sch:Text"
		},
		"aliasPatches": {
			"@id": "twin-aig:aliasPatches"
		},
		"auditMode": {
			"@id": "twin-aig:auditMode",
			"@type": "sch:Text"
		},
		"edgePatches": {
			"@id": "twin-aig:edgePatches"
		},
		"edgeRelationships": {
			"@id": "twin-aig:edgeRelationships",
			"@container": "@set"
		},
		"edges": {
			"@id": "twin-aig:edges",
			"@container": "@set"
		},
		"patches": {
			"@id": "twin-aig:patches",
			"@container": "@set"
		},
		"patchFrom": {
			"@id": "twin-aig:patchFrom",
			"@type": "sch:Text"
		},
		"patchOperation": {
			"@id": "twin-aig:patchOperation",
			"@type": "sch:Text"
		},
		"patchPath": {
			"@id": "twin-aig:patchPath",
			"@type": "sch:Text"
		},
		"patchValue": {
			"@id": "twin-aig:patchValue",
			"@type": "@json"
		},
		"proofId": {
			"@id": "twin-aig:proofId",
			"@type": "sch:identifier"
		},
		"remove": {
			"@id": "twin-aig:remove",
			"@container": "@set"
		},
		"resourceObject": {
			"@id": "twin-aig:resourceObject",
			"@type": "@json"
		},
		"resourcePatches": {
			"@id": "twin-aig:resourcePatches"
		},
		"resources": {
			"@id": "twin-aig:resources",
			"@container": "@set"
		},
		"targetId": {
			"@id": "twin-aig:targetId",
			"@type": "@id"
		},
		"unique": {
			"@id": "twin-aig:unique",
			"@type": "sch:Boolean"
		},
		"verification": {
			"@id": "twin-aig:verification"
