{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/aig/AuditableItemGraphVertexList",
	"title": "AuditableItemGraphVertexList",
	"description": "Interface describing an auditable item graph vertex list.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "array",
			"prefixItems": [
				{
					"const": "https://schema.org"
				},
				{
					"const": "https://schema.3sixty.global/aig/"
				}
			],
			"items": {
				"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionElement"
			},
			"minItems": 2,
			"description": "JSON-LD Context."
		},
		"type": {
			"type": "array",
			"prefixItems": [
				{
					"const": "ItemList"
				},
				{
					"const": "AuditableItemGraphVertexList"
				}
			],
			"items": false,
			"minItems": 2,
			"maxItems": 2,
			"description": "JSON-LD Type."
		},
		"itemListElement": {
			"type": "array",
			"items": {
				"$ref": "https://schema.3sixty.global/aig/AuditableItemGraphVertex"
			},
			"description": "The list of vertices."
		}
	},
	"required": ["@context", "type", "itemListElement"]
}
