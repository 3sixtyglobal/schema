{
	"@context": {
		"@version": 1.1,
		"twin-common": "https://schema.3sixty.global/common/",
		"schema": "http://schema.org/",
		"id": "@id",
		"type": "@type",
		"nodeIdentity": {
			"@id": "twin-common:nodeIdentity",
			"@type": "schema:identifier"
		},
		"userIdentity": {
			"@id": "twin-common:userIdentity",
			"@type": "schema:identifier"
		},
		"organizationIdentity": {
			"@id": "twin-common:organizationIdentity",
			"@type": "schema:identifier"
		},
		"cursor": {
			"@id": "twin-common:cursor",
			"@type": "schema:Text"
		},
		"annotationObject": {
			"@id": "twin-common:annotationObject",
			"@type": "@json"
		},
		"attestationObject": {
			"@id": "twin-common:attestationObject"
		},
		"verified": {
			"@id": "twin-common:verified",
			"@type": "schema:Boolean"
		},
		"proofIntegrity": {
			"@id": "twin-common:proofIntegrity",
			"@type": "schema:Text"
		}
	}
}