{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/ais/AuditableItemStreamEntryObjectList",
	"title": "AuditableItemStreamEntryObjectList",
	"description": "Interface describing an auditable item stream entries object list.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "array",
			"prefixItems": [
				{
					"const": "https://schema.org"
				},
				{
					"const": "https://schema.3sixty.global/ais/"
				},
				{
					"const": "https://schema.3sixty.global/common/"
				}
			],
			"items": {
				"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionElement"
			},
			"minItems": 3,
			"description": "JSON-LD Context."
		},
		"type": {
			"type": "array",
			"prefixItems": [
				{
					"const": "ItemList"
				},
				{
					"const": "AuditableItemStreamEntryObjectList"
				}
			],
			"items": false,
			"minItems": 2,
			"maxItems": 2,
			"description": "JSON-LD Type."
