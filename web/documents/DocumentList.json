{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/documents/DocumentList",
	"description": "Interface describing a list of document entries.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "array",
			"minItems": 3,
			"description": "JSON-LD Context.",
			"prefixItems": [
				{
					"type": "string",
					"const": "https://schema.org"
				},
				{
					"type": "string",
					"const": "https://schema.twindev.org/documents/"
				},
				{
					"type": "string",
					"const": "https://schema.twindev.org/common/"
				}
			],
			"items": {
				"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
			}
		},
		"type": {
			"type": "string",
			"const": "ItemList",
			"description": "JSON-LD Type."
		},
		"itemListElement": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/documents/Document"
			},
			"description": "The list of documents. json-ld namespace:schema"
		},
		"edges": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"description": "The ids of the other vertices which are connected to the document. json-ld container:set"
		}
	},
	"required": ["@context", "type", "itemListElement"],
	"additionalProperties": false
}
