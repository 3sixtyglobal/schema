{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/dataspace-protocol/DataspaceProtocolTransferProcess",
	"description": "Interface for Dataspace Protocol Transfer Messages. https://eclipse-dataspace-protocol-base.github.io/DataspaceProtocol/#ack-transfer-process",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The Dataspace Protocol JSON-LD context type.",
			"anyOf": [
				{
					"type": "array",
					"items": {
						"type": "string",
						"const": "https://w3id.org/dspace/2025/1/context.jsonld"
					},
					"minItems": 1,
					"maxItems": 1
				},
				{
					"type": "array",
					"minItems": 2,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://w3id.org/dspace/2025/1/context.jsonld"
						},
						{
							"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				},
				{
					"type": "array",
					"minItems": 2,
					"prefixItems": [
						{
							"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
						},
						{
							"type": "string",
							"const": "https://w3id.org/dspace/2025/1/context.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@type": {
			"type": "string",
			"const": "TransferProcess",
			"description": "LD Type"
		},
		"consumerPid": {
			"type": "string",
			"description": "MUST refer to the transfer identifier of the Consumer side."
		},
		"providerPid": {
			"type": "string",
			"description": "MUST refer to the transfer identifier of the Provider side."
		},
		"state": {
			"type": "object",
			"properties": {
				"COMPLETED": {
					"type": "string",
					"const": "COMPLETED"
				},
				"REQUESTED": {
					"type": "string",
					"const": "REQUESTED"
				},
				"STARTED": {
					"type": "string",
					"const": "STARTED"
				},
				"SUSPENDED": {
					"type": "string",
					"const": "SUSPENDED"
				},
				"TERMINATED": {
					"type": "string",
					"const": "TERMINATED"
				}
			},
			"required": ["COMPLETED", "REQUESTED", "STARTED", "SUSPENDED", "TERMINATED"],
			"additionalProperties": false,
			"description": "The transfer process state."
		}
	},
	"required": ["@context", "@type", "consumerPid", "providerPid", "state"],
	"additionalProperties": false
}
