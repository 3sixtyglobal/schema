{
	"@context": {
		"@version": 1.1,
		"@protected": true,
		"twin-attestation": "https://schema.twindev.org/attestation/",
		"twin-common": "https://schema.twindev.org/common/",
		"schema": "http://schema.org/",
		"id": "@id",
		"type": "@type",
		"AttestationInformation": "twin-attestation:AttestationInformation",
		"AttestationJwtProof": "twin-attestation:AttestationJwtProof",
		"dateTransferred": {
			"@id": "twin-attestation:dateTransferred",
			"@type": "schema:Date"
		},
		"holderIdentity": {
			"@id": "twin-attestation:holderIdentity",
			"@type": "schema:identifier"
		},
		"ownerIdentity": {
			"@id": "twin-attestation:ownerIdentity",
			"@type": "schema:identifier"
		},
		"value": {
			"@id": "twin-attestation:value",
			"@type": "schema:Text"
		},
		"verificationFailure": {
			"@id": "twin-attestation:verificationFailure",
			"@type": "schema:Text"
		}
	}
}
