{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/attestation/AttestationJwtProof",
	"title": "AttestationJwtProof",
	"description": "Interface describing an attestation proof.",
	"type": "object",
	"properties": {
		"@context": {
			"anyOf": [
				{
					"const": "https://schema.3sixty.global/attestation/"
				},
				{
					"type": "array",
					"prefixItems": [
						{
							"const": "https://schema.3sixty.global/attestation/"
						}
					],
					"items": {
						"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionElement"
					},
					"minItems": 1
				}
			],
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "JwtProof",
			"description": "The type of the proof."
		},
		"value": {
			"type": "string",
			"description": "The value of the proof."
		}
	},
	"required": ["@context", "type", "value"]
}
