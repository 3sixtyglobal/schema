{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/rights-management/DataAccessQueryResponse",
	"description": "The JSON-LD definition for the data access request.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "string",
			"const": "https://schema.twindev.org/rights-management",
			"description": "The JSON-LD context."
		},
		"type": {
			"type": "string",
			"const": "DataAccessQueryResponse",
			"description": "The type of the request."
		},
		"items": {
			"type": "array",
			"items": false,
			"description": "The items matching the query.",
			"prefixItems": [
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
				}
			]
		},
		"cursor": {
			"type": "string",
			"description": "The cursor for pagination, if any."
		}
	},
	"required": ["@context", "type", "items"],
	"additionalProperties": false
}
