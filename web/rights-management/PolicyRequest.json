{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/rights-management/PolicyRequest",
	"description": "The JSON-LD definition for a proof request.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "array",
			"minItems": 2,
			"items": false,
			"maxItems": 2,
			"description": "The JSON-LD context.",
			"prefixItems": [
				{
					"type": "string",
					"const": "https://www.w3.org/ns/credentials/v2"
				},
				{
					"type": "string",
					"const": "https://schema.twindev.org/rights-management"
				}
			]
		},
		"type": {
			"type": "string",
			"const": "PolicyRequest",
			"description": "The type of the proof."
		},
		"id": {
			"type": "string",
			"description": "The id of the policy."
		},
		"nodeIdentity": {
			"type": "string",
			"description": "The id of the the node."
		},
		"proof": {
			"$ref": "https://schema.twindev.org/w3c-did/Proof",
			"description": "The proof object."
		}
	},
	"required": ["@context", "type", "id", "nodeIdentity", "proof"],
	"additionalProperties": false
}
