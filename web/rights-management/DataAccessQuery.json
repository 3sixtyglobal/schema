{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/rights-management/DataAccessQuery",
	"description": "The JSON-LD definition for the data access request.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "string",
			"const": "https://schema.twindev.org/rights-management/",
			"description": "The JSON-LD context."
		},
		"type": {
			"type": "string",
			"const": "DataAccessQuery",
			"description": "The type of the request."
		},
		"assetType": {
			"type": "string",
			"description": "The asset type being requested."
		},
		"conditions": {
			"$ref": "https://schema.twindev.org/rights-management/EntityCondition%3CIJsonLdNodeObject%3E",
			"description": "The conditions to filter the items."
		},
		"cursor": {
			"type": "string",
			"description": "The cursor for pagination, if any."
		},
		"options": {
			"description": "Additional options which might be supported by the handler."
		}
	},
	"required": ["@context", "type"],
	"additionalProperties": false
}
