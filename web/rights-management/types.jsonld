{
	"@context": {
		"@version": 1.1,
		"@protected": true,
		"twin-rm": "https://schema.twindev.org/rights-management/",
		"w3c-did": "https://schema.twindev.org/w3c-did/",
		"schema": "http://schema.org/",
		"id": "@id",
		"type": "@type",
		"PolicyNegotiationRequest": "twin-rm:PolicyNegotiationRequest",
		"PolicyRequest": "twin-rm:PolicyRequest",
		"PolicyState": "twin-rm:PolicyState",
		"PolicyNegotiationStatus": "twin-rm:PolicyNegotiationStatus",
		"assetType": {
			"@id": "twin-rm:assetType",
			"@type": "schema:Text"
		},
		"action": {
			"@id": "twin-rm:action",
			"@type": "schema:Text"
		},
		"resourceId": {
			"@id": "twin-rm:resourceId",
			"@type": "schema:Text"
		},
		"nodeIdentity": {
			"@id": "twin-rm:nodeIdentity",
			"@type": "schema:Text"
		},
		"information": {
			"@id": "twin-rm:information",
			"@type": "@json"
		},
		"proof": {
			"@id": "twin-rm:proof"
		}
	}
}