	"properties": {
		"type": {
			"anyOf": [
				{
					"const": "Event"
				},
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"anyOf": [
							{
								"const": "Event"
							},
							{
								"type": "string"
							}
						]
					}
				}
			],
			"description": "Event type."
		}
	},
	"required": ["type"],
	"allOf": [
		{
			"$ref": "https://schema.twindev.org/w3c-activity-streams/ActivityStreamsObject"
		}
	]
}
