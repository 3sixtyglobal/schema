{
	"@context": {
		"@version": 1.1,
		"twin-synchronised-storage": "https://schema.3sixty.global/synchronised-storage/",
		"schema": "http://schema.org/",
		"id": "@id",
		"type": "@type",
		"SyncRequest": "twin-synchronised-storage:SyncRequest",
		"SynchronisedEntityCore": "twin-synchronised-storage:SynchronisedEntityCore",
		"SyncChange": "twin-synchronised-storage:SyncChange",
		"SyncChangeSet": "twin-synchronised-storage:SyncChangeSet",
		"SynchronisedEntity": "twin-synchronised-storage:SynchronisedEntity",
