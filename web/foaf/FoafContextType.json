						"const": "https://xmlns.com/foaf/0.1/"
					}
				]
			},
			"contains": {
				"const": "https://xmlns.com/foaf/0.1/"
			},
			"minContains": 1,
			"maxContains": 1,
			"minItems": 1
		}
	]
}
