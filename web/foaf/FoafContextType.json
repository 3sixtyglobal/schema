{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/foaf/FoafContextType",
	"title": "FoafContextType",
	"description": "The FOAF JSON-LD context type.",
	"anyOf": [
		{
			"const": "https://xmlns.com/foaf/0.1/"
		},
		{
			"type": "array",
			"items": {
				"anyOf": [
					{
						"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionElement"
