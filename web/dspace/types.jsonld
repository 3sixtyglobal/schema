{
    "@context": {
        "@version": 1.1,
        "@import": "https://schema.twindev.org/odrl/types.jsonld",
        "twin": "https://schema.twindev.org/",
        "twin-dspace": "twin:dspace",
        "dcat": "http://www.w3.org/ns/dcat#",
        "dct": "http://purl.org/dc/terms/",

        "CatalogQueryByExample": "twin-dspace:CatalogQueryByExample",
        "CatalogQuery": "twin-dspace:CatalogQuery",
        "entity": {
            "@id": "twin-dspace:entity",
            "@type": "@id"
        },
        "title": "dct:title",
        "description": "dct:description",
        "mediaType": "dcat:mediaType",
        "publisher": "dct:publisher",
        "license": "dct:license",
        "entityType": {
            "@id": "dct:type",
            "@type": "@vocab"
        },

        "Http-Pull-Query-Format": "twin-dspace:Http-Pull-Query-Format",
        "Http-Push-Activity-Stream-Format": "twin-dspace:Http-Push-Activity-Stream-Format",
        "Http-Post-Activity-Stream-Format": "twin-dspace:Http-Post-Activity-Stream-Format",

        "Https-Query-Endpoint": "twin-dspace:Https-Query-Endpoint",
        "Https-Activity-Stream-Endpoint": "twin-dspace:Https-Activity-Stream-Endpoint"
    }
}