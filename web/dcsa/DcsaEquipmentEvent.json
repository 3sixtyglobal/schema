{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/dcsa/DcsaEquipmentEvent",
	"title": "DcsaEquipmentEvent",
	"description": "The `EquipmentEvent` is a specialized event to handle all events related to equipment (containers).\n\nSource: `equipmentEvent` schema in the DCSA Event Domain (v3.1.0).",
	"oneOf": [
		{
			"type": "object",
			"properties": {
				"metadata": {
					"allOf": [
						{
							"$ref": "https://schema.twindev.org/dcsa/DcsaEventMetadataActive"
						},
						{
							"type": "object",
							"properties": {
								"eventType": {
									"const": "EQUIPMENT"
								}
							},
							"required": ["eventType"]
						}
					],
					"description": "Event metadata (eventType = EQUIPMENT)."
				},
				"payload": {
					"$ref": "https://schema.twindev.org/dcsa/DcsaEquipmentPayload",
					"description": "Business attributes related to the `EquipmentEvent`."
				}
			},
			"required": ["metadata", "payload"]
		},
		{
			"type": "object",
			"properties": {
				"metadata": {
					"allOf": [
						{
							"$ref": "https://schema.twindev.org/dcsa/DcsaEventMetadataRetraction"
						},
						{
							"type": "object",
							"properties": {
								"eventType": {
									"const": "EQUIPMENT"
								}
							},
							"required": ["eventType"]
						}
					],
					"description": "Retraction metadata (eventType = EQUIPMENT)."
				},
				"payload": {
					"not": {},
					"description": "Retractions do not carry payloads."
				}
			},
			"required": ["metadata"]
		}
	]
}
