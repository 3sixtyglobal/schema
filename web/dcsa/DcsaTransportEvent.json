{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/dcsa/DcsaTransportEvent",
	"title": "DcsaTransportEvent",
	"description": "The `TransportEvent` is a specialized event to handle all events related to transportation.\n\nSource: `transportEvent` schema in the DCSA Event Domain (v3.1.0).",
	"oneOf": [
		{
			"type": "object",
			"properties": {
				"metadata": {
					"allOf": [
						{
							"$ref": "https://schema.twindev.org/dcsa/DcsaEventMetadataActive"
						},
						{
							"type": "object",
							"properties": {
								"eventType": {
									"const": "TRANSPORT"
								}
							},
							"required": ["eventType"]
						}
					],
					"description": "Event metadata (eventType = TRANSPORT)."
				},
				"payload": {
					"$ref": "https://schema.twindev.org/dcsa/DcsaTransportPayload",
					"description": "Business attributes related to the `TransportEvent`."
				}
			},
			"required": ["metadata", "payload"]
		},
		{
			"type": "object",
			"properties": {
				"metadata": {
					"type": "object",
					"properties": {
						"eventType": {
							"const": "TRANSPORT"
						}
					},
					"required": ["eventType"],
					"allOf": [
						{
							"$ref": "https://schema.twindev.org/dcsa/DcsaEventMetadataRetraction"
						}
					],
					"description": "Retraction metadata (eventType = TRANSPORT)."
				},
				"payload": {
					"not": {},
					"description": "Retractions do not carry payloads."
				}
			},
			"required": ["metadata"]
		}
	]
}
