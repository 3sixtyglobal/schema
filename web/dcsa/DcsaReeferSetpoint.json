{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/dcsa/DcsaReeferSetpoint",
	"title": "DcsaReeferSetpoint",
	"description": "Reefer setpoint values.\n\nSource: `reeferSetpoint` schema in the DCSA Event Domain (v3.1.0).\n\nNote: The OpenAPI references value ranges and units from DCSA_DOMAIN; this package models values as numbers and\nunit fields as strings.",
	"type": "object",
	"properties": {
		"temperature": {
			"type": "number",
			"description": "Target temperature."
		},
		"temperatureUnit": {
			"type": "string",
			"description": "Temperature unit."
		},
		"o2": {
			"type": "number",
			"description": "Target O2."
		},
		"co2": {
			"type": "number",
			"description": "Target CO2."
		},
		"humidity": {
			"type": "number",
			"description": "Target humidity."
		},
		"airExchange": {
			"type": "number",
			"description": "Target air exchange."
		},
		"airExchangeUnit": {
			"type": "string",
			"description": "Air exchange unit."
		}
	}
}
