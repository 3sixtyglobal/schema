{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/immutable-proof/ImmutableProof",
	"title": "ImmutableProof",
	"description": "Interface describing an immutable proof state.",
	"type": "object",
	"properties": {
		"@context": {
			"type": "array",
			"prefixItems": [
				{
					"const": "https://schema.3sixty.global/immutable-proof/"
				},
				{
					"const": "https://schema.3sixty.global/common/"
				}
			],
			"items": false,
			"minItems": 2,
			"maxItems": 2,
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "ImmutableProof",
			"description": "JSON-LD Type."
		},
		"id": {
			"type": "string",
			"description": "The id of the object associated with the proof."
		},
		"proofIntegrity": {
			"type": "string",
			"description": "The integrity hash of the object associated with the proof."
		}
	},
	"required": ["proofIntegrity"]
}
