{
	"@context": {
		"@version": 1.1,
		"@protected": true,
		"twin-immutable-proof": "https://schema.twindev.org/immutable-proof/",
		"twin-common": "https://schema.twindev.org/common/",
		"schema": "http://schema.org/",
		"id": "@id",
		"type": "@type",
		"ImmutableProof": "twin-immutable-proof:ImmutableProof",
		"ImmutableProofReceipt": "twin-immutable-proof:ImmutableProofReceipt",
		"ImmutableProofVerification": "twin-immutable-proof:ImmutableProofVerification",
		"failure": {
			"@id": "twin-immutable-proof:failure",
			"@type": "schema:Text"
		},
		"immutableReceipt": {
			"@id": "twin-immutable-proof:immutableReceipt"
		},
		"verifiableStorageId": {
			"@id": "twin-immutable-proof:verifiableStorageId"
		}
	}
}
