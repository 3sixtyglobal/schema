{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceSection",
	"description": "The parts into which a label is or may be divided.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "Section",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdValueObject"
				}
			],
			"description": "The identifier of this label section."
		},
		"includedSegment": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceSegment"
			},
			"description": "A segment included in this label section."
		},
		"patternCode": {
			"type": "string",
			"description": "The code specifying the pattern of this label section."
		}
	},
	"required": ["type"]
}
