{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/unece/UneceSection",
	"title": "UneceSection",
	"description": "The parts into which a label is or may be divided.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.3sixty.global/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "Section",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The identifier of this label section."
		},
		"includedSegment": {
			"type": "array",
			"items": {
				"$ref": "https://schema.3sixty.global/unece/UneceSegment"
			},
			"description": "A segment included in this label section."
		},
		"patternCode": {
			"type": "string",
			"description": "The code specifying the pattern of this label section."
		}
	},
	"required": ["type"]
}
