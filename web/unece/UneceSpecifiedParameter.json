{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceSpecifiedParameter",
	"description": "A specified feature that is fixed for the case in question but may be different in other cases.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "SpecifiedParameter",
			"description": "JSON-LD Type."
		},
		"description": {
			"type": "string",
			"description": "A textual description for this specified parameter."
		},
		"identifier": {
			"type": "string",
			"description": "The identifier of this specified parameter."
		},
		"name": {
			"type": "string",
			"description": "The name, expressed as text, for this specified parameter."
		},
		"parameterType": {
			"type": "string",
			"description": "A type, expressed as text, for this specified parameter."
		},
		"statusCode": {
			"type": "string",
			"description": "The code specifying the status of this specified parameter."
		},
		"statusValueMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceMeasureType"
			},
			"description": "A measure of a value of the status for this specified parameter."
		},
		"typeCode": {
			"type": "string",
			"description": "The code specifying the type of parameter."
		},
		"value": {
			"type": "string",
			"description": "The value, expressed as text, for this specified parameter."
		},
		"valueAllowedIndicator": {
			"type": "boolean",
			"description": "The indication of whether or not the value for this specified parameter is allowed."
		},
		"valueMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceMeasureType"
			},
			"description": "A measure of a value for this specified parameter."
		},
		"valueTolerance": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceTolerance"
			},
			"description": "A tolerance specified for the value of this parameter."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
