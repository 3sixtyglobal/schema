{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceInstalmentPlan",
	"description": "A plan for paying a total sum of money by several payments made over a period of time.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "InstalmentPlan",
			"description": "JSON-LD Type."
		},
		"specifiedInstalmentPayment": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceInstalmentPayment"
			},
			"description": "An instalment payment specified for this instalment plan."
		}
	},
	"required": ["type", "specifiedInstalmentPayment"]
}
