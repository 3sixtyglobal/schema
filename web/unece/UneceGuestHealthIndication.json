{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceGuestHealthIndication",
	"description": "A guest's physical or mental condition.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "GuestHealthIndication",
			"description": "JSON-LD Type."
		},
		"description": {
			"type": "string",
			"description": "A textual description of this guest health indication."
		},
		"restriction": {
			"type": "string",
			"description": "A restriction, expressed as text, for this guest health indication."
		},
		"status": {
			"type": "string",
			"description": "A status, expressed as text, for this guest health indication."
		},
		"typeCode": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceGuestHealthIndicationTypeCodeList"
				},
				{
					"type": "string"
				}
			],
			"description": "The code specifying the type of guest heath indication."
		}
	},
	"required": ["type"]
}
