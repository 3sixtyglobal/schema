{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UnecePayload",
	"description": "Transmitted data that is included in an XHE (Exchange Header Envelope).",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "Payload",
			"description": "JSON-LD Type."
		},
		"includedPayloadInstance": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UnecePayloadInstance"
			},
			"description": "A payload instance included in this XHE payload."
		}
	},
	"required": ["type", "includedPayloadInstance"]
}
