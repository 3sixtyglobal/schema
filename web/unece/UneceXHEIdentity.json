{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceXHEIdentity",
	"title": "UneceXHEIdentity",
	"description": "Information which uniquely identifies an XHE (Exchange Header Envelope) object.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "XHEIdentity",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdValueObject"
				}
			],
			"description": "The identifier of this XHE identity."
		}
	},
	"required": ["type", "identifier"]
}
