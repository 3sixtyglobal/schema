{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceError",
	"description": "A notification that an error has occurred.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "Error",
			"description": "JSON-LD Type."
		},
		"associatedEvent": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceCorrectiveEvent"
			},
			"description": "A corrective event associated with this declared error."
		},
		"issueDateTime": {
			"type": "string",
			"description": "An issue date, time, date time or other date time value for this declared error."
		},
		"reasonCode": {
			"type": "string",
			"description": "A code specifying a reason for the declared error."
		}
	},
	"required": ["type"]
}
