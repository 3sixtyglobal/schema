{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceNegotiationContext",
	"description": "The protocol and setting of a negotiation.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "NegotiationContext",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"type": "string",
			"description": "The identifier of the negotiation context."
		},
		"typeCode": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceNegotiationContextTypeCodeList"
				},
				{
					"type": "string"
				}
			],
			"description": "The code specifying the type for this negotiation context, such as chain negotiation, item negotiation or counterpart negotiation."
		}
	},
	"required": ["type"]
}
