{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceNegotiationContext",
	"title": "UneceNegotiationContext",
	"description": "The protocol and setting of a negotiation.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.twindev.org/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "NegotiationContext",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdValueObject"
				}
			],
			"description": "The identifier of the negotiation context."
		},
		"typeCode": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceNegotiationContextTypeCodeList"
				},
				{
					"type": "string"
				}
			],
			"description": "The code specifying the type for this negotiation context, such as chain negotiation, item negotiation or counterpart\nnegotiation."
		}
	},
	"required": ["type"]
}
