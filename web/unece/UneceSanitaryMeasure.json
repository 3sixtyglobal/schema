{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceSanitaryMeasure",
	"description": "Sanitary measures as reported for a WHO MDH (Maritime Declaration of Health).",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "SanitaryMeasure",
			"description": "JSON-LD Type."
		},
		"applicationDateTime": {
			"type": "string",
			"description": "An application date, time, date time or other date time value for this MDH sanitary measure.",
			"format": "date-time"
		},
		"description": {
			"type": "string",
			"description": "A textual description of this MDH sanitary measure."
		},
		"location": {
			"type": "string",
			"description": "A location, expressed as text, for this MDH sanitary measure."
		},
		"typeCode": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceSanitaryMeasureTypeCodeList"
				},
				{
					"type": "string"
				}
			],
			"description": "A code specifying a type of MDH sanitary measure."
		}
	},
	"required": ["type"]
}
