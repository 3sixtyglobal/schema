{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceIdentifiedFault",
	"description": "An identified defect or fault.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "IdentifiedFault",
			"description": "JSON-LD Type."
		},
		"description": {
			"type": "string",
			"description": "A textual description of this identified fault."
		},
		"identificationCode": {
			"type": "string",
			"description": "A code specifying an identified fault."
		}
	},
	"required": ["type"]
}
