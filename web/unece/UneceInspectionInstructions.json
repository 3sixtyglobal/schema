{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceInspectionInstructions",
	"description": "Information of an instructive nature that describes how to conduct an inspection.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "InspectionInstructions",
			"description": "JSON-LD Type."
		},
		"description": {
			"type": "string",
			"description": "A textual description of this set of inspection instructions."
		},
		"identifier": {
			"type": "string",
			"description": "An identifier of this set of inspection instructions."
		},
		"inspectionInstructionsDescriptionCode": {
			"type": "string",
			"description": "The code specifying a description of a set of inspection instructions."
		},
		"instructionsType": {
			"type": "string",
			"description": "A type, expressed as text, of this set of inspection instructions."
		},
		"interpretationCode": {
			"type": "string",
			"description": "The code specifying the interpretation for this set of inspection instructions."
		},
		"latestUpdateDateTime": {
			"type": "string",
			"description": "The date, time, date time, or other date time value of the latest update of this set of inspection instructions."
		},
		"procedure": {
			"type": "string",
			"description": "A procedure, expressed as text, for a set of inspection instructions."
		},
		"propertyReferenceCode": {
			"type": "string",
			"description": "The code specifying the property reference of this set of inspection instructions."
		},
		"sequenceNumeric": {
			"type": "string",
			"description": "The sequence number of this set of inspection instructions."
		},
		"statusCode": {
			"type": "string",
			"description": "The code specifying the status of this set of inspection instructions."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
