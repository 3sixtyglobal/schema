{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/SpatialDimension",
	"description": "A measure of spatial extent of an object, such as the length, breadth or height of a shipping container.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "SpatialDimension",
			"description": "JSON-LD Type."
		},
		"componentSpatialDimension": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/SpatialDimension"
			},
			"description": "A dimension that is a component of this spatial dimension."
		},
		"description": {
			"type": "string",
			"description": "A textual description of this spatial dimension."
		},
		"dimensionTypeCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/DimensionTypeCodeList"
			},
			"description": "The code specifying the type of spatial dimension, such as thickness, area, or volume."
		},
		"heightMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/MeasureType"
			},
			"description": "The measure of the height component of this spatial dimension."
		},
		"identifier": {
			"type": "string",
			"description": "The unique identifier of this spatial dimension."
		},
		"lengthMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/MeasureType"
			},
			"description": "The measure of the length component of this spatial dimension."
		},
		"linearUnitDiameterMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LinearUnitMeasureType"
			},
			"description": "The measure of the diameter component for this spatial dimension."
		},
		"linearUnitHeightMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LinearUnitMeasureType"
			},
			"description": "The measure of the height component of this spatial dimension."
		},
		"linearUnitLengthMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LinearUnitMeasureType"
			},
			"description": "The measure of the length component of this spatial dimension."
		},
		"linearUnitWidthMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LinearUnitMeasureType"
			},
			"description": "The measure of the width component of this spatial dimension."
		},
		"unitQuantity": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/QuantityType"
			},
			"description": "The number of units with these spatial dimensions."
		},
		"unitValueMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UnitMeasureType"
			},
			"description": "The measure of the value of this spatial dimension."
		},
		"widthMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/MeasureType"
			},
			"description": "The measure of the width component of this spatial dimension."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
