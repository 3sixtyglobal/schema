{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceSegment",
	"description": "The parts into which a segment is or may be divided.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "Segment",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"type": "string",
			"description": "The identifier of this section segment."
		},
		"imageBinaryObject": {
			"type": "string",
			"description": "The image, expressed as a binary object, for this section segment."
		},
		"information": {
			"type": "string",
			"description": "Information, expressed as text, in this section segment."
		},
		"typeCode": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceSegmentTypeCodeList"
				},
				{
					"type": "string"
				}
			],
			"description": "The code specifying the type of section segment."
		}
	},
	"required": ["type"]
}
