{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceSubordinateLocation",
	"description": "A physical location or place which is a subordinate location of a location.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "SubordinateLocation",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"type": "string",
			"description": "The unique identifier for this subordinate location, such as a United Nations Location Code (UNLOCODE) or GS1 Global Location Number (GLN)."
		},
		"locationFunctionTypeCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceLocationFunctionCodeList"
			},
			"description": "The code specifying the type of subordinate location."
		},
		"name": {
			"type": "string",
			"description": "The name, expressed as text, of this subordinate location."
		},
		"physicalGeographicalCoordinate": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceGeographicalCoordinate"
			},
			"description": "Physical geographical coordinate information for this subordinate location."
		},
		"subordinateSubordinateSubordinateLocation": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceSubordinateSubordinateLocation"
			},
			"description": "The location subordinate to this subordinate location."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
