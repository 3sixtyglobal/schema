{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/TTLocation",
	"description": "A physical place related to a Track and Trace (TT) process.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"type": "string",
			"const": "TTLocation",
			"description": "JSON-LD Type."
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"applicableTechnicalCharacteristic": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TechnicalCharacteristic"
			},
			"description": "A technical characteristic applicable to this TT location."
		},
		"description": {
			"type": "string",
			"description": "A textual description of this TT location."
		},
		"identifier": {
			"type": "string",
			"description": "The identifier for this TT location."
		},
		"locationFunctionTypeCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LocationFunctionCodeList"
			},
			"description": "The code specifying the type of TT location."
		},
		"name": {
			"type": "string",
			"description": "A name, expressed as text, of this TT location."
		},
		"responsibleTTParty": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TTParty"
			},
			"description": "The party responsible for this TT location."
		},
		"specifiedAnimalHoldingEvent": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/AnimalHoldingEvent"
			},
			"description": "An animal holding event specified for this TT location."
		},
		"specifiedGeographicalArea": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/GeographicalArea"
			},
			"description": "The geographical area specified for this TT location."
		},
		"specifiedTTAnimal": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TTAnimal"
			},
			"description": "An animal specified for this TT location."
		}
	},
	"required": ["@type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
