{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/unece/UneceEmployerIdentity",
	"title": "UneceEmployerIdentity",
	"description": "Identification of a party who pays someone to do work on a regular or contractual basis.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.3sixty.global/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "EmployerIdentity",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The unique identifier for this employer identity."
		}
	},
	"required": ["type"]
}
