{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/unece/UneceUnitMeasureType",
	"title": "UneceUnitMeasureType",
	"description": "A numeric value determined by measuring an object along with the specified unit of measure.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.3sixty.global/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "UnitMeasureType",
			"description": "JSON-LD Type."
		},
		"UnitMeasureTypeValue": {
			"type": "string",
			"description": "The numeric value."
		},
		"UnitMeasureTypeCode": {
			"$ref": "https://schema.3sixty.global/unece/UneceUnitMeasureCode",
			"description": "The unit code."
		}
	},
	"required": ["type"]
}
