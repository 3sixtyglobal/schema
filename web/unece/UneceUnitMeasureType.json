{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceUnitMeasureType",
	"description": "A numeric value determined by measuring an object along with the specified unit of measure.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "UnitMeasureType",
			"description": "JSON-LD Type."
		},
		"UnitMeasureTypeValue": {
			"type": "string",
			"description": "The numeric value."
		},
		"UnitMeasureTypeCode": {
			"$ref": "https://schema.twindev.org/unece/UneceUnitMeasureCode",
			"description": "The unit code."
		}
	},
	"required": ["type"]
}
