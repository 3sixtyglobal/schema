{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/unece/UnecePersonIdentity",
	"title": "UnecePersonIdentity",
	"description": "Identification of a person.",
	"type": "object",
	"properties": {
		"@context": {
			"$ref": "https://schema.3sixty.global/unece/UneceContextType",
			"description": "JSON-LD Context."
		},
		"type": {
			"const": "PersonIdentity",
			"description": "JSON-LD Type."
		},
		"alienRegistrationId": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The alien registration identifier for this person."
		},
		"driversLicenceId": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The drivers licence identifier for this person."
		},
		"identityCardId": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The identity card identifier for this person."
		},
		"passportId": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The passport identifier for this person."
		},
		"socialSecurityId": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
				}
			],
			"description": "The social security identifier for this person."
		},
		"specifiedProprietaryIdentity": {
			"type": "array",
			"items": {
				"$ref": "https://schema.3sixty.global/unece/UneceProprietaryIdentity"
			},
			"description": "A proprietary Identity specified for this person."
		}
	},
	"required": ["type"]
}
