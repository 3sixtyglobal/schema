{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceVolumeUnitMeasureCode",
	"title": "UneceVolumeUnitMeasureCode",
	"description": "RDF Class for VolumeUnitMeasureType unit code type to define unit code values.",
	"oneOf": [
