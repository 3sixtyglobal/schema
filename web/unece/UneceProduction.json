{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceProduction",
	"description": "The making or manufacturing of goods, such as from components or raw materials.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "Production",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"type": "string",
			"description": "The identifier for this production of goods."
		},
		"manufacturingProcessDescription": {
			"type": "string",
			"description": "A textual description of the manufacturing process for this goods production."
		}
	},
	"required": ["type"]
}
