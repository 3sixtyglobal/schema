{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceCargo",
	"description": "Information about goods being transported identifying their nature for customs, statistical or transport purposes.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "Cargo",
			"description": "JSON-LD Type."
		},
		"cargoCategoryTypeCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceCargoCategoryCodeList"
			},
			"description": "The code, such as UNECE Recommendation 21 single digit codes, specifying the type of transported cargo."
		},
		"cargoCommodityCategoryStatisticalClassificationCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceCargoCommodityCategoryCodeList"
			},
			"description": "The code specifying a statistical classification for this transport cargo."
		},
		"cargoOperationalCategoryCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/UneceCargoOperationalCategoryCodeList"
			},
			"description": "The code specifying the operational category for this transport cargo, such as obnoxious or military."
		},
		"identification": {
			"type": "string",
			"description": "Identification, expressed as text, of this transport cargo that is sufficient to identify it for customs, statistical or transport purposes."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
