{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/GuestArrival",
	"description": "The act of coming to or reaching a place by a specified guest.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "GuestArrival",
			"description": "JSON-LD Type."
		},
		"carrierId": {
			"type": "string",
			"description": "The identifier of the carrier for this specified guest arrival."
		},
		"carrierName": {
			"type": "string",
			"description": "A carrier's name, expressed as text, related to this specified guest arrival."
		},
		"expectedDateTime": {
			"type": "string",
			"description": "The date, time, date time, or other date time value when this specified guest arrival is expected."
		},
		"transportModeCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TransportModeCodeList"
			},
			"description": "The code specifying the transport mode of this specified guest arrival."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
