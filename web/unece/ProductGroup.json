{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/ProductGroup",
	"description": "A grouping of trade products.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "ProductGroup",
			"description": "JSON-LD Type."
		},
		"identifier": {
			"type": "string",
			"description": "An identifier for this trade product group."
		},
		"includedSupplyChainTradeLineItem": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/SupplyChainTradeLineItem"
			},
			"description": "A supply chain trade line item which is included in this trade product group."
		},
		"includedTradeProduct": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TradeProduct"
			},
			"description": "A product included in this trade product group."
		},
		"name": {
			"type": "string",
			"description": "The name, expressed as text, for this trade product group."
		},
		"specifiedDocument": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/Document"
			},
			"description": "A referenced document specified for this trade product group."
		},
		"subordinateProductGroup": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/ProductGroup"
			},
			"description": "A product group subordinate to this trade product group."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
