{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/TTParty",
	"description": "An individual, group, or body related to a Track and Trace (TT) process.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"type": "string",
			"const": "TTParty",
			"description": "JSON-LD Type."
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"identifier": {
			"type": "string",
			"description": "An identifier for this TT party."
		},
		"managedCharacteristic": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TechnicalCharacteristic"
			},
			"description": "A technical characteristic managed by this TT party."
		},
		"name": {
			"type": "string",
			"description": "The name, expressed as text, for this TT party."
		},
		"partyTypeCode": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/PartyTypeCodeList"
			},
			"description": "A code specifying the type of TT party."
		},
		"residenceCountryId": {
			"type": "string",
			"description": "The identifier for the country of residence for this TT party, such as the country in which a person lives or in which a corporation has its place of incorporation."
		},
		"specifiedTTAnimal": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TTAnimal"
			},
			"description": "A tracking animal specified for this TT party."
		},
		"specifiedTTLocation": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/TTLocation"
			},
			"description": "A location specified for this TT party."
		},
		"tTPartyRoleCode": {
			"type": "string",
			"description": "A code specifying the role of this TT party."
		},
		"typeId": {
			"type": "string",
			"description": "An identifier of the type for this TT party."
		}
	},
	"required": ["@type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
