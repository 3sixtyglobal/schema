{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/Convoy",
	"description": "A number of means of transport following each other with a common logistics purpose.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "Convoy",
			"description": "JSON-LD Type."
		},
		"maximumWidthMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LinearUnitMeasureType"
			},
			"description": "The maximum width measure for this logistics convoy."
		},
		"overallLengthMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LinearUnitMeasureType"
			},
			"description": "The overall length measure of this logistics convoy."
		},
		"powerActiveTransportMeans": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LogisticsTransportMeans"
			},
			"description": "A means of transport actively powering this logistics convoy."
		},
		"powerInactiveTransportMeans": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/LogisticsTransportMeans"
			},
			"description": "A means of transport not actively powering this logistics convoy."
		},
		"transportMeansQuantity": {
			"$ref": "https://schema.twindev.org/unece/QuantityType",
			"description": "The number of means of transport in this logistics convoy."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
