{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/LaboratoryObservationContact",
	"description": "A person or department that acts as a point of contact for laboratory observations.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"type": "string",
			"const": "LaboratoryObservationContact",
			"description": "JSON-LD Type."
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"departmentName": {
			"type": "string",
			"description": "The name, expressed as text, of the department to which this laboratory observation contact belongs."
		},
		"emailCommunication": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/Communication"
			},
			"description": "The email address of this laboratory observation contact."
		},
		"faxCommunication": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/Communication"
			},
			"description": "The fax number of this laboratory observation contact."
		},
		"identifier": {
			"type": "string",
			"description": "The identifier of this laboratory observation contact."
		},
		"mobileTelephoneCommunication": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/Communication"
			},
			"description": "The mobile phone number of this laboratory observation contact."
		},
		"personName": {
			"type": "string",
			"description": "The name, expressed as text, of the person for this laboratory observation contact."
		},
		"telephoneCommunication": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/Communication"
			},
			"description": "The telephone number of this laboratory observation contact."
		}
	},
	"required": ["@type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
