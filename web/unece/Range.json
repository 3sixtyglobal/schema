{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/Range",
	"description": "A row, line or series, commonly used to express the difference between lowest and highest values.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"type": "string",
			"const": "Range",
			"description": "JSON-LD Type."
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"endId": {
			"type": "string",
			"description": "The identifier of the end of this specified range."
		},
		"maximumValueMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/MeasureType"
			},
			"description": "The measure of the maximum value for this specified range."
		},
		"minimumValueMeasure": {
			"type": "array",
			"items": {
				"$ref": "https://schema.twindev.org/unece/MeasureType"
			},
			"description": "The measure of the minimum value for this specified range."
		},
		"startId": {
			"type": "string",
			"description": "The identifier of the start of this specified range."
		},
		"totalItemQuantity": {
			"$ref": "https://schema.twindev.org/unece/QuantityType",
			"description": "The total number of items in this specified range."
		},
		"typeCode": {
			"type": "string",
			"description": "The code specifying a type of this specified range."
		},
		"value": {
			"type": "string",
			"description": "A value, expressed as text, for this specified range."
		},
		"valueBaseSystemCode": {
			"type": "string",
			"description": "The code specifying the value base system, such as Arabic numerals, for this specified range."
		},
		"valueCode": {
			"type": "string",
			"description": "A code specifying a value for this specified range."
		}
	},
	"required": ["@type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
