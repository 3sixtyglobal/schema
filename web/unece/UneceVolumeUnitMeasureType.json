{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceVolumeUnitMeasureType",
	"description": "The numeric value determined by volume measuring.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "VolumeUnitMeasureType",
			"description": "JSON-LD Type."
		},
		"VolumeUnitMeasureTypeValue": {
			"type": "string",
			"description": "The numeric value."
		},
		"VolumeUnitMeasureTypeCode": {
			"$ref": "https://schema.twindev.org/unece/UneceVolumeUnitMeasureCode",
			"description": "The unit code."
		}
	},
	"required": ["type"]
}
