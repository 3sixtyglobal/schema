{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceGovernmentRegistration",
	"description": "The recording of items or details for a governmental purpose.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"@id": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@included": {
			"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
		},
		"@graph": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdNodeObject"
					}
				}
			]
		},
		"@nest": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.twindev.org/unece/JsonLdJsonObject"
					}
				}
			]
		},
		"@type": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			]
		},
		"@reverse": {
			"type": "object",
			"additionalProperties": {
				"type": "string"
			}
		},
		"@index": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"const": "GovernmentRegistration",
			"description": "JSON-LD Type."
		},
		"categoryCode": {
			"type": "string",
			"description": "A code specifying a category of this government registration."
		},
		"countryId": {
			"$ref": "https://schema.twindev.org/unece/UneceCountryId",
			"description": "The identifier of the country for this government registration."
		},
		"countrySubDivisionId": {
			"type": "string",
			"description": "The identifier of the country sub-division for this registration."
		},
		"identifier": {
			"type": "string",
			"description": "An identifier for this government registration."
		},
		"lastRegisteredYearDateTime": {
			"type": "string",
			"description": "The last registered year of this government registration."
		},
		"licenceId": {
			"type": "string",
			"description": "The identifier of a licence for this government registration."
		},
		"recordedDate": {
			"type": "string",
			"description": "The date that this government registration was recorded."
		},
		"typeCode": {
			"anyOf": [
				{
					"$ref": "https://schema.twindev.org/unece/UneceGovernmentRegistrationTypeCodeList"
				},
				{
					"type": "string"
				}
			],
			"description": "A code specifying a type of government registration."
		},
		"validityPeriod": {
			"$ref": "https://schema.twindev.org/unece/UneceSpecifiedPeriod",
			"description": "The period of time during which this government registration is valid."
		},
		"versionId": {
			"type": "string",
			"description": "The identifier of the version of this government registration."
		}
	},
	"required": ["type"],
	"additionalProperties": {
		"anyOf": [
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdNodePrimitive"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdLanguageMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIndexMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIncludedBlock"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdIdMap"
			},
			{
				"$ref": "https://schema.twindev.org/unece/JsonLdTypeMap"
			},
			{
				"type": "array"
			}
		]
	}
}
