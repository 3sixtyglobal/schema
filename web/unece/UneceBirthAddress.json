{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.twindev.org/unece/UneceBirthAddress",
	"description": "The place of birth.",
	"type": "object",
	"properties": {
		"@context": {
			"description": "The UNECE JSON-LD context type.",
			"anyOf": [
				{
					"type": "string",
					"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
				},
				{
					"type": "array",
					"minItems": 1,
					"prefixItems": [
						{
							"type": "string",
							"const": "https://vocabulary.uncefact.org/unece-context-D23B.jsonld"
						}
					],
					"items": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
					}
				}
			]
		},
		"type": {
			"type": "string",
			"const": "BirthAddress",
			"description": "JSON-LD Type."
		},
		"birthAddressCountryId": {
			"anyOf": [
				{
					"type": "string"
				},
				{
					"$ref": "https://schema.twindev.org/json-ld/JsonLdValueObject"
				}
			],
			"description": "The identifier of a country for this birth address."
		},
		"cityName": {
			"type": "string",
			"description": "The name, expressed as text, of the city, town or village of this birth address."
		},
		"countrySubDivisionName": {
			"type": "string",
			"description": "The name, expressed as text, of the sub-division of a country for this birth address."
		}
	},
	"required": ["type"]
}
