{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/w3c-did/DidVerifiableCredentialV2",
	"title": "DidVerifiableCredentialV2",
	"description": "Interface describing a verifiable credential.\nhttps://www.w3.org/TR/vc-data-model-2.0",
	"type": "object",
	"properties": {
		"@context": {
			"anyOf": [
				{
					"const": "https://www.w3.org/ns/credentials/v2"
				},
				{
					"type": "array",
					"items": {
						"anyOf": [
							{
								"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionElement"
							},
							{
								"const": "https://www.w3.org/ns/credentials/v2"
							}
						]
					},
					"contains": {
						"const": "https://www.w3.org/ns/credentials/v2"
					},
					"minContains": 1,
					"maxContains": 1,
					"minItems": 1
				}
			],
			"description": "The context for the verifiable credential."
		},
		"validFrom": {
			"type": "string",
			"description": "The date the verifiable credential is valid from."
		},
		"validUntil": {
			"type": "string",
			"description": "The date the verifiable credential is valid until."
		}
	},
	"required": ["@context"],
	"allOf": [
		{
			"$ref": "https://schema.3sixty.global/w3c-did/DidVerifiableCredentialCommon"
		}
	]
}
