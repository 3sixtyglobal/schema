{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/gs1/EpcisHeader",
	"title": "EpcisHeader",
	"description": "EPCIS 2.0 Header carrying optional master data alongside an EPCIS document.",
	"type": "object",
	"properties": {
		"epcisMasterData": {
			"allOf": [
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdNodeObject"
				},
				{
					"type": "object",
					"properties": {
						"vocabularyList": {
							"type": "array",
							"items": {
								"$ref": "https://schema.3sixty.global/gs1/EpcisVocabulary"
							},
							"description": "Vocabulary list."
						}
					}
				}
			],
			"description": "EPCIS master data."
		}
	}
}
