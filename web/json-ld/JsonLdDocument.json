{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/json-ld/JsonLdDocument",
	"title": "JsonLdDocument",
	"description": "A JSON-LD document MUST be valid JSON text as described in [RFC8259],\nor some format that can be represented in the JSON-LD internal representation\nthat is equivalent to valid JSON text.",
	"anyOf": [
		{
			"$ref": "https://schema.3sixty.global/json-ld/JsonLdNodeObject"
		},
		{
			"type": "array",
			"items": {
				"$ref": "https://schema.3sixty.global/json-ld/JsonLdNodeObject"
			}
		},
		{
			"type": "object",
			"properties": {
				"@context": {
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdContextDefinitionRoot"
				},
				"@graph": {
					"anyOf": [
						{
							"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
						},
						{
							"$ref": "https://schema.3sixty.global/json-ld/JsonLdNodeObject"
						},
						{
							"type": "array",
							"items": {
								"anyOf": [
									{
										"$ref": "https://schema.3sixty.global/json-ld/JsonLdValueObject"
									},
									{
										"$ref": "https://schema.3sixty.global/json-ld/JsonLdNodeObject"
									}
								]
							}
						}
					]
				}
			}
		}
	]
}
