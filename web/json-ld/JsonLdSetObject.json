{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schema.3sixty.global/json-ld/JsonLdSetObject",
	"title": "JsonLdSetObject",
	"description": "A set represents an unordered set of values.",
	"type": "object",
	"properties": {
		"@set": {
			"anyOf": [
				{
					"$ref": "https://schema.3sixty.global/json-ld/JsonLdListOrSetItem"
				},
				{
					"type": "array",
					"items": {
						"$ref": "https://schema.3sixty.global/json-ld/JsonLdListOrSetItem"
					}
				}
			]
		},
		"@index": {
			"type": "string"
		}
	},
	"required": ["@set"]
}
